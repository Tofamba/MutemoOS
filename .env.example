# Mutemo Desk — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file — it's already in .gitignore.

# ── Required ──────────────────────────────────────────────────────────────────
# Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Optional: Password Protection ───────────────────────────────────────────────
# If MUTEMO_PASSWORD is set, the entire app requires a login (browser will show
# a username/password prompt). Leave blank/commented to disable — fine for a
# desktop-only pilot, but STRONGLY recommended if hosted on a network or the internet.
# MUTEMO_USERNAME=mutemo
# MUTEMO_PASSWORD=choose-a-strong-password

# ── Optional: Email Reminders ───────────────────────────────────────────────────
# If these are not set, the Calendar tab will show a warning and email
# reminders won't send. Everything else works normally without them.

# Gmail example (use an App Password, not your normal password):
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=youraddress@gmail.com

# Office 365 example:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
